<Window x:Class="SemiconductorCsvAnalyzer.ProductManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:SemiconductorCsvAnalyzer.Controls"
        Title="产品良率与数据管理 · CSV Analyzer" Width="1460" Height="910" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#F3F6FB" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/WorkspaceTheme.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="31"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="Background" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/><Setter Property="ClipboardCopyMode" Value="IncludeHeader"/>
        </Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="9"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,12,0"/></Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource WorkspaceButton}"><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="0,0,7,6"/></Style>
        <Style x:Key="FilterableHeader" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="6,3"/>
            <Setter Property="ToolTip" Value="输入关键字筛选；右键勾选需要显示的值。"/>
        </Style>
        <DataTemplate x:Key="ManagedFilterHeader">
            <StackPanel>
                <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                    <DataTrigger Binding="{Binding Column.(controls:ManagementGridFilter.State).IsActive, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="True"><Setter Property="Background" Value="#DBEAFE"/></DataTrigger>
                </Style.Triggers></Style></StackPanel.Style>
                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                <TextBox Text="{Binding Column.(controls:ManagementGridFilter.State).Text, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}, UpdateSourceTrigger=PropertyChanged}"
                         Height="21" MinWidth="32" Margin="0,3,0,0" Padding="3,0" FontSize="11" BorderBrush="#CBD5E1" Background="White" FontWeight="Normal"/>
            </StackPanel>
        </DataTemplate>
    </ResourceDictionary></Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,24"><controls:ActionIcon Kind="Wafer" Width="28" Height="28" Stroke="#2563EB" Margin="0,0,10,0"/><TextBlock Text="产品数据管理" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/></StackPanel>
                    <TextBlock Text="搜索产品" Foreground="#64748B" Margin="0,0,0,5"/><TextBox x:Name="TxtProductSearch" Padding="9,7" TextChanged="ProductSearch_Changed" Margin="0,0,0,12"/>
                    <TextBlock Text="产品库" Foreground="#64748B" Margin="0,0,0,8"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="BtnAddProduct" Content="＋ 创建产品" Click="AddProduct_Click" Style="{StaticResource PrimaryButton}" Margin="0,12,0,10"/>
                    
                </StackPanel>
                <ListBox x:Name="ProductList" SelectionChanged="Product_Changed" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource SegmentOption}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,6"/></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding FileSummary}" FontSize="11" Foreground="#64748B" Margin="0,5,0,0"/>
                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <DockPanel Grid.Column="1" Margin="22,18">
            <StackPanel DockPanel.Dock="Top">
                <DockPanel Margin="0,0,0,14">
                    <Button Content="打开独立分析器" Click="Standalone_Click" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Padding="15,8"/>
                    <StackPanel><TextBlock x:Name="TxtProductName" Text="欢迎使用产品数据管理" FontSize="24" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock x:Name="TxtProductInfo" Text="" Foreground="#64748B" Margin="0,6,10,0" TextWrapping="Wrap"/></StackPanel>
                </DockPanel>
                <WrapPanel x:Name="ProductActions" IsEnabled="False" Margin="0,0,0,8">
                    <Button Content="产品与流程" Click="EditProduct_Click" Style="{StaticResource SmallButton}"/>
                    <Button Content="删除产品" Click="DeleteProduct_Click" Style="{StaticResource SmallButton}" Foreground="#B42318"/>
                    <Button Content="登记数据文件" Click="Import_Click" Style="{StaticResource SmallButton}"/>
                    <Button Content="登记物理分 Bin 良率" Click="SpecifiedYield_Click" Style="{StaticResource SmallButton}"/>
                    <Button Content="重新计算" Click="Recalculate_Click" Style="{StaticResource SmallButton}"/>
                    <Button Content="导出 XLSX 管理报告" Click="ExportReport_Click" Style="{StaticResource SmallButton}"/>
                    <Button Content="导出当前趋势 PNG" Click="ExportPng_Click" Style="{StaticResource SmallButton}"/>
                </WrapPanel>
                <UniformGrid Columns="4" Margin="0,0,0,12">
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CP 综合良率" Foreground="#64748B"/><TextBlock x:Name="TxtCpYield" Text="–" FontSize="26" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,6,0,4"/><TextBlock x:Name="TxtCpCount" Foreground="#64748B" FontSize="11"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="FT 综合良率" Foreground="#64748B"/><TextBlock x:Name="TxtFtYield" Text="–" FontSize="26" FontWeight="SemiBold" Foreground="#0F766E" Margin="0,6,0,4"/><TextBlock x:Name="TxtFtCount" Foreground="#64748B" FontSize="11"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="批次 / CP 晶圆" Foreground="#64748B"/><TextBlock x:Name="TxtLots" Text="–" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,4"/><TextBlock Text="可按批次、晶圆筛选" Foreground="#64748B" FontSize="11"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0"><StackPanel><TextBlock Text="登记数据 / 未覆盖" Foreground="#64748B"/><TextBlock x:Name="TxtFiles" Text="–" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,4"/><TextBlock x:Name="TxtCalculated" Foreground="#64748B" FontSize="11"/></StackPanel></Border>
                </UniformGrid>
                <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" Padding="10,8" CornerRadius="6" Margin="0,0,0,10">
                    <TextBlock x:Name="TxtNotice" Text="也可以直接打开独立分析器，不使用产品管理。" Foreground="#475569" TextWrapping="Wrap"/>
                </Border>
                <WrapPanel Margin="0,0,0,10">
                    <TextBlock Text="批次 / 晶圆筛选" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtFilter" Width="240" HorizontalAlignment="Left" Padding="7,5" TextChanged="Filter_Changed"/>
                    <TextBlock Text="统计口径" VerticalAlignment="Center" Margin="18,0,8,0"/>
                    <RadioButton x:Name="PeriodWafer" Content="晶圆" GroupName="Period" IsChecked="True" Checked="Period_Changed" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="PeriodLot" Content="批次" GroupName="Period" Checked="Period_Changed" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="PeriodMonth" Content="月" GroupName="Period" Checked="Period_Changed" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="PeriodYear" Content="年" GroupName="Period" Checked="Period_Changed" VerticalAlignment="Center"/>
                </WrapPanel>
                <TextBlock x:Name="TxtPeriodNote" Visibility="Collapsed" Text="" Foreground="#64748B" FontSize="11" Margin="0,0,0,8"/>
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button x:Name="BtnCancel" Content="取消计算" Click="Cancel_Click" DockPanel.Dock="Right" Visibility="Collapsed" Style="{StaticResource QuietButton}"/>
                <ProgressBar x:Name="BusyBar" DockPanel.Dock="Left" IsIndeterminate="True" Visibility="Collapsed" Width="80" Height="5" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtStatus" Text="就绪" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TabControl x:Name="MainTabs">
                <TabItem Header="良率趋势">
                    <DockPanel Margin="10">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <RadioButton x:Name="CpMode" Content="CP" GroupName="Kind" IsChecked="True" Checked="TrendMode_Changed" Margin="0,0,20,0"/>
                            <RadioButton x:Name="FtMode" Content="FT" GroupName="Kind" Checked="TrendMode_Changed" Margin="0,0,24,0"/>
                        </WrapPanel>
                        <controls:ManagementTrendView x:Name="YieldTrend"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="良率明细">
                    <DataGrid x:Name="DgYields" Margin="10" FrozenColumnCount="3" ColumnHeaderStyle="{StaticResource FilterableHeader}"
                              SelectionMode="Single" SelectionUnit="FullRow" PreviewMouseRightButtonDown="YieldRow_RightButtonDown" LoadingRow="YieldRow_Loading">
                        <DataGrid.RowStyle><Style TargetType="DataGridRow">
                            <Style.Triggers><DataTrigger Binding="{Binding IsCombined}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="#EFF6FF"/></DataTrigger></Style.Triggers>
                        </Style></DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="YieldPeriodColumn" Header="统计期间" Binding="{Binding PeriodLabel}" Width="130" Visibility="Collapsed"/>
                            <DataGridTextColumn Header="批次" Binding="{Binding Lot}" Width="125"/><DataGridTextColumn Header="晶圆" Binding="{Binding Wafer}" Width="120"/>
                            <DataGridTextColumn Header="步骤" Binding="{Binding StageName}" Width="180"/><DataGridTextColumn Header="芯片数" Binding="{Binding TotalText}" Width="85"/>
                            <DataGridTextColumn Header="良品" Binding="{Binding GoodText}" Width="80"/><DataGridTextColumn Header="不良" Binding="{Binding FailedText}" Width="80"/>
                            <DataGridTextColumn Header="未完成" Binding="{Binding Pending}" Width="80"/><DataGridTextColumn Header="良率" Binding="{Binding YieldText}" Width="95"/>
                            <DataGridTextColumn Header="缺温芯片" Binding="{Binding MissingTemperature}" Width="90"/><DataGridTextColumn Header="身份缺失" Binding="{Binding MissingIdentity}" Width="90"/>
                            <DataGridTextColumn Header="Pass" Binding="{Binding PassText}" Width="80"/><DataGridTextColumn Header="PartialPass" Binding="{Binding PartialPassText}" Width="100"/>
                            <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="130"/><DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="450"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="数据文件">
                    <DockPanel Margin="10">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button Content="打开 / 合并选中文件" Click="OpenFile_Click" Style="{StaticResource SmallButton}" ToolTip="支持 Ctrl / Shift 多选同一步骤的文件，按登记顺序自动合并。"/>
                            <Button Content="编辑登记 / 指定值" Click="EditFile_Click" Style="{StaticResource SmallButton}"/>
                            <Button Content="重新定位文件" Click="Relocate_Click" Style="{StaticResource SmallButton}"/>
                            <Button Content="删除登记（保留原文件）" Click="RemoveFiles_Click" Style="{StaticResource SmallButton}"/>
                        </WrapPanel>
                        <DataGrid x:Name="DgFiles" SelectionMode="Extended" ColumnHeaderStyle="{StaticResource FilterableHeader}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="文件" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="批次" Binding="{Binding Lot}" Width="110"/>
                                <DataGridTextColumn Header="步骤" Binding="{Binding Stage}" Width="180"/><DataGridTextColumn Header="晶圆片号" Binding="{Binding Wafer}" Width="110"/>
                                <DataGridTextColumn Header="测试时间" Binding="{Binding File.TestTimeText}" Width="180"/>
                                <DataGridTextColumn Header="记录数" Binding="{Binding Records}" Width="80"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="180"/>
                                <DataGridTextColumn Header="原路径" Binding="{Binding Path}" Width="450"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="不良分类">
                    <DockPanel Margin="10">
                        <StackPanel DockPanel.Dock="Top">
                            <ListBox x:Name="CategoryStages" DisplayMemberPath="Label" SelectionChanged="CategoryStage_Changed" BorderThickness="0" Background="Transparent" Margin="0,0,0,8" ItemContainerStyle="{StaticResource SegmentOption}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            </ListBox>
                            <Button Content="打开分类趋势图与数据表" Click="CategoryTrend_Click" Style="{StaticResource SmallButton}" HorizontalAlignment="Left"/>
                            
                        </StackPanel>
                        <DataGrid x:Name="DgCategories" ColumnHeaderStyle="{StaticResource FilterableHeader}"><DataGrid.Columns>
                            <DataGridTextColumn x:Name="CategoryPeriodColumn" Header="统计期间" Binding="{Binding PeriodLabel}" Width="130" Visibility="Collapsed"/>
                            <DataGridTextColumn Header="批次" Binding="{Binding Lot}" Width="160"/><DataGridTextColumn Header="晶圆" Binding="{Binding Wafer}" Width="160"/>
                            <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="200"/><DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="100"/>
                            <DataGridTextColumn Header="有效 SBIN" Binding="{Binding Total}" Width="110"/><DataGridTextColumn Header="占比 %" Binding="{Binding Percent, StringFormat=F2, TargetNullValue=–}" Width="110"/>
                        </DataGrid.Columns></DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="测试流程">
                    <DockPanel Margin="12">
                        <TextBlock x:Name="TxtRules" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,15"/>
                        <DataGrid x:Name="DgFlow"><DataGrid.Columns>
                            <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="100"/><DataGridTextColumn Header="步骤" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn Header="温度 °C" Binding="{Binding Temperature}" Width="130"/><DataGridCheckBoxColumn Header="必测" Binding="{Binding Required}" Width="100"/>
                        </DataGrid.Columns></DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
