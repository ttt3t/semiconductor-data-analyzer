<Window x:Class="SemiconductorCsvAnalyzer.ImportDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="追加 / 批量导入" Width="560" Height="570" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="TxtError" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" Width="80" Padding="8,5"/>
                <Button Content="导入" Click="BtnImport_Click" Width="80" Padding="8,5" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="TxtFile" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                    <Button Content="上移" Click="MoveUp_Click" Padding="8,4"/>
                    <Button Content="下移" Click="MoveDown_Click" Padding="8,4" Margin="0,6,0,0"/>
                </StackPanel>
                <ListBox x:Name="FileList" Height="76" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            
            <GroupBox Header="1. Wafer 关系" Margin="0,0,0,12">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="NewWafer" GroupName="Wafer" Content="不同 wafer" IsChecked="True" Margin="0,0,24,0"/>
                        <RadioButton x:Name="SameWafer" GroupName="Wafer" Content="同 wafer"/>
                    </StackPanel>
                    <ComboBox x:Name="CmbTargetWafer" Margin="0,10,0,0" IsEnabled="{Binding IsChecked, ElementName=SameWafer}"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="2. 测试项匹配方式" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <RadioButton x:Name="MatchNumber" GroupName="Match" Content="按序号" Margin="0,0,32,0"/>
                    <RadioButton x:Name="MatchName" GroupName="Match" Content="按测试项名称" IsChecked="True"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="3. 已匹配测试项的阈值" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <RadioButton x:Name="OldLimits" GroupName="Limits" Content="使用旧文件阈值" IsChecked="True" Margin="0,0,24,0"/>
                    <RadioButton x:Name="NewLimits" GroupName="Limits" Content="使用新文件阈值"/>
                </StackPanel>
            </GroupBox>
            
        </StackPanel>
    </DockPanel>
</Window>
