<Window x:Class="SemiconductorCsvAnalyzer.IniLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="可视化 INI 设置" Width="1120" Height="730" MinWidth="780" MinHeight="510"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="{DynamicResource WorkspaceBackground}" Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <ResourceDictionary Source="Styles/WorkspaceTheme.xaml"/>
    </Window.Resources>
    <DockPanel Margin="18">
        <StackPanel x:Name="SampleControls" DockPanel.Dock="Top">
            <TextBlock x:Name="ScopeText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <DockPanel x:Name="TargetPanel" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock Text="配置来源" VerticalAlignment="Center" Margin="0,0,10,0" DockPanel.Dock="Left"/>
                <ComboBox x:Name="TargetList" DisplayMemberPath="Name" SelectionChanged="Target_Changed" Padding="6,4"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Left" Content="打开样本…" Click="OpenSample_Click"
                        Style="{StaticResource WorkspaceButton}" Margin="0,0,8,0"/>
                <ComboBox x:Name="SheetList" DockPanel.Dock="Right" MinWidth="145" DisplayMemberPath="Name"
                          SelectionChanged="Worksheet_Changed" Padding="6,4" Margin="8,0,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="SampleName" Text="选择普通 CSV 或 Excel 文件" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
            </DockPanel>
            <TextBlock x:Name="SampleStatus" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" Style="{StaticResource WorkspaceButton}"/>
                <Button x:Name="SyncButton" Content="保存并同步" Click="Save_Click"
                        Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="SaveStatus" TextWrapping="Wrap" Foreground="#9A3412" VerticalAlignment="Center" Margin="0,0,14,0"/>
        </DockPanel>
        <Grid x:Name="EditorBody">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="305"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="SampleGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                      RowHeight="27" ColumnHeaderHeight="32" FrozenColumnCount="1"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                      PreviewMouseLeftButtonDown="Grid_DragStart" PreviewMouseMove="Grid_DragMove"
                      PreviewMouseLeftButtonUp="Grid_DragEnd" LostMouseCapture="Grid_LostCapture"/>
            <Border Grid.Column="2" Padding="12" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <TextBlock x:Name="SelectionHelp" DockPanel.Dock="Top" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                    <TabControl>
                        <TabItem Header="表格布局">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="6,8">
                                    <StackPanel x:Name="LayoutFields"/>
                                    <CheckBox x:Name="SkipRepeated" Content="跳过重复表头" ToolTip="SkipRepeatedHeaders"
                                              Margin="4,8,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="身份列">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="IdentityFields" Margin="6,8"/>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
