<Window x:Class="SemiconductorCsvAnalyzer.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="详细说明 · CSV Analyzer V2.0.4" Width="1080" Height="800" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Microsoft YaHei UI" Background="{DynamicResource WorkspaceBackground}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ContentsItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="10,9"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Highlight" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Highlight" Property="Background" Value="#F1F5F9"/></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Highlight" Property="Background" Value="#DBEAFE"/><Setter Property="Foreground" Value="#1D4ED8"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="使用手册" Foreground="{DynamicResource TextPrimary}" FontSize="23" FontWeight="SemiBold"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="8" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="目录" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="10,6,0,10"/>
                    <ListBox x:Name="ContentsList" BorderThickness="0" Background="Transparent" DisplayMemberPath="Title"
                             Foreground="{DynamicResource TextSecondary}" ItemContainerStyle="{StaticResource ContentsItem}"
                             SelectionChanged="Contents_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <FlowDocumentScrollViewer x:Name="DocumentViewer" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"/>
                </Grid>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="关闭" IsCancel="True" Style="{StaticResource QuietButton}" MinWidth="76"/>
            <TextBlock x:Name="HelpStatus" Text="" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
