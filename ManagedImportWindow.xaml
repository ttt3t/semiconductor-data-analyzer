<Window x:Class="SemiconductorCsvAnalyzer.ManagedImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="登记产品数据与良率" Width="1250" Height="820" MinWidth="1000" MinHeight="720"
        WindowStartupLocation="CenterOwner" Background="#F3F6FB" FontFamily="Microsoft YaHei UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/WorkspaceTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <DockPanel Margin="20">
        <StackPanel x:Name="ImportInputs" DockPanel.Dock="Top">
            <TextBlock Text="登记数据 · 选择测试步骤与批次" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock x:Name="TxtBasis" Foreground="#64748B" Margin="0,0,0,8"/>
            <DockPanel Margin="0,0,0,6">
                <ProgressBar x:Name="MetadataBusy" DockPanel.Dock="Left" Width="65" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtMetadataStatus" Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/>
            </DockPanel>
            <CheckBox x:Name="SpecifiedMode" Content="指定良率（不解析原文件，可登记物理分 Bin 结果）" Click="SpecifiedMode_Changed" Margin="0,0,0,12"/>
            <TextBlock Text="本次文件属于哪个步骤？"/>
            <ListBox x:Name="StageList" DisplayMemberPath="Label" BorderThickness="0" Background="Transparent" Margin="0,6,0,12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource SegmentOption}">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
            </ListBox>
            <WrapPanel Margin="0,0,0,10">
                <TextBlock Text="批次：" VerticalAlignment="Center"/><TextBox x:Name="TxtLot" Width="190" Padding="7,5" Margin="0,0,8,0" TextChanged="Lot_Changed"/>
                <Button Content="应用到所有文件" Click="ApplyLot_Click" Style="{StaticResource WorkspaceButton}" Margin="0,0,20,0"/>
                <RadioButton x:Name="StandardMode" Content="普通 STDF" GroupName="Stdf" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <RadioButton x:Name="Mode93K" Content="93k STDF（TSR 名称）" GroupName="Stdf" VerticalAlignment="Center"/>
            </WrapPanel>
            <DockPanel Margin="0,0,0,12">
                <Button Content="另选解析 INI" Click="ChooseConfig_Click" Style="{StaticResource WorkspaceButton}" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtConfigName" Text="使用产品默认配置" VerticalAlignment="Center" Foreground="#64748B"/>
            </DockPanel>
            <Expander Header="从文件名识别片号与测试时间（不含扩展名，字符位置从 1 开始；规则按产品保存）" IsExpanded="True" Margin="0,0,0,10">
                <StackPanel Margin="0,8,0,0">
                    <WrapPanel Margin="0,0,0,7">
                        <CheckBox x:Name="ExtractWafer" Content="识别片号" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Text="起始位置" VerticalAlignment="Center"/><TextBox x:Name="WaferStart" Width="48" Margin="6,0,12,0" Padding="4"/>
                        <TextBlock Text="长度" VerticalAlignment="Center"/><TextBox x:Name="WaferLength" Width="48" Margin="6,0,20,0" Padding="4"/>
                        <Button Content="识别空白项" Click="ExtractMissing_Click" Style="{StaticResource WorkspaceButton}" Margin="0,0,8,0"/>
                        <Button Content="重新识别并覆盖" Click="ExtractAll_Click" Style="{StaticResource WorkspaceButton}"/>
                    </WrapPanel>
                    <WrapPanel>
                        <CheckBox x:Name="ExtractTime" Content="识别时间" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Text="起始位置" VerticalAlignment="Center"/><TextBox x:Name="TimeStart" Width="48" Margin="6,0,12,0" Padding="4"/>
                        <TextBlock Text="长度（0＝自动）" VerticalAlignment="Center"/><TextBox x:Name="TimeLength" Width="48" Margin="6,0,12,0" Padding="4"/>
                        <TextBlock Text="格式（可选）" VerticalAlignment="Center"/><TextBox x:Name="TimeFormat" Width="180" Margin="6,0,0,0" Padding="4" ToolTip="例如 yyyyMMdd_HHmmss；长度为 0 时自动识别标准日期时间。"/>
                    </WrapPanel>
                    <TextBlock x:Name="TxtNamingStatus" Foreground="#64748B" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
            </Expander>
            <WrapPanel Margin="0,0,0,10">
                <TextBlock Text="统一测试时间：" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtAllTime" Width="190" Padding="6,4" Margin="0,0,8,0" ToolTip="yyyy-MM-dd HH:mm:ss 或 yyyy-MM-dd"/>
                <Button Content="应用到全部时间" Click="ApplyTime_Click" Style="{StaticResource WorkspaceButton}" Margin="0,0,8,0"/>
                <Button Content="全部设为当前时间" Click="CurrentTime_Click" Style="{StaticResource WorkspaceButton}"/>
            </WrapPanel>
            <StackPanel x:Name="SpecifiedHelp" Visibility="Collapsed" Margin="0,0,0,10">
                
                <DockPanel Margin="0,8,0,0"><TextBlock Text="来源说明：" VerticalAlignment="Center"/><TextBox x:Name="TxtOrigin" Text="物理分 Bin" Padding="6,4"/></DockPanel>
            </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            
            <TextBlock x:Name="TxtError" Foreground="#B42318" TextWrapping="Wrap" Margin="0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" Style="{StaticResource WorkspaceButton}" Margin="0,0,8,0"/>
                <Button x:Name="BtnSave" Content="登记并计算" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </StackPanel>
        <DataGrid x:Name="DgFiles" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeight="32"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="文件" Binding="{Binding FileName}" IsReadOnly="True" Width="250" MinWidth="180"/>
                <DataGridTextColumn Header="批次" Binding="{Binding Lot, UpdateSourceTrigger=PropertyChanged}" Width="155"/>
                <DataGridTextColumn Header="晶圆号（可选覆盖）" Binding="{Binding WaferOverride, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                <DataGridTextColumn Header="测试时间（可手填）" Binding="{Binding TestTimeText, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}" Width="195"/>
                <DataGridTextColumn Header="时间来源" Binding="{Binding TestTimeSource}" IsReadOnly="True" Width="130"/>
                <DataGridTextColumn x:Name="TotalColumn" Header="总数（可留空）" Binding="{Binding SpecifiedTotal, ValidatesOnExceptions=True, TargetNullValue=''}" Width="110" Visibility="Collapsed"/>
                <DataGridTextColumn x:Name="GoodColumn" Header="良品数" Binding="{Binding SpecifiedGood, ValidatesOnExceptions=True, TargetNullValue=''}" Width="95" Visibility="Collapsed"/>
                <DataGridTextColumn x:Name="YieldColumn" Header="良率 %" Binding="{Binding SpecifiedPercent, ValidatesOnExceptions=True, TargetNullValue=''}" Width="100" Visibility="Collapsed"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
