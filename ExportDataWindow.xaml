<Window x:Class="SemiconductorCsvAnalyzer.ExportDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出数据" Width="570" Height="670" MinWidth="490" MinHeight="590"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel x:Name="ExportOptions" DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <GroupBox Header="2. 测试记录保留方式">
                <StackPanel Margin="12">
                    <RadioButton x:Name="KeepAll" Content="首测与复测均保留" IsChecked="True" Margin="0,0,0,8"/>
                    <RadioButton x:Name="KeepFirst" Content="只保留首测" Margin="0,0,0,8"/>
                    <RadioButton x:Name="KeepLast" Content="复测覆盖首测"/>
                    <TextBlock Margin="0,12,0,0" Foreground="DimGray" TextWrapping="Wrap"
                               Text="与 Testitem Yield 一致，按晶圆、芯片及测试项选择首末记录。部分复测未测到的项目保留原记录；原文格式与异常值一并导出。"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="3. 离群点处理" Margin="0,10,0,0">
                <StackPanel Margin="12">
                    <CheckBox x:Name="ChkRemoveOutliers" Content="剔除离群点（仅影响本次导出）"
                              Checked="ClearError" Unchecked="ClearError"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                IsEnabled="{Binding IsChecked, ElementName=ChkRemoveOutliers}">
                        <TextBlock Text="保留范围：均值 ±" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtOutlierSigma" Text="6" Width="65" Margin="6,0" Padding="4,2" TextChanged="ClearError"/>
                        <TextBlock Text="σ" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" Foreground="DimGray" TextWrapping="Wrap"
                               Text="先筛选晶圆与复测记录，再合并所选晶圆和 Site，逐测项计算均值与总体 σ，只剔除一次。超限测项留空，其余测项及异常原文保留。"/>
                </StackPanel>
            </GroupBox>
            <GroupBox x:Name="ReportSettings" Header="4. 报告设置" Margin="0,10,0,0" Visibility="Collapsed">
                <StackPanel Margin="12">
                    <TextBlock Text="直方图模式（同步主窗口）"/>
                    <ListBox x:Name="ReportHistogramMode" SelectedIndex="0" Margin="0,6,0,8"
                             BorderThickness="0" Background="Transparent" SelectionChanged="ReportHistogramMode_Changed">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBoxItem Content="固定等宽"/>
                        <ListBoxItem Content="规格区间"/>
                        <ListBoxItem Content="中位数中心"/>
                    </ListBox>
                    <CheckBox x:Name="ReportCombineSites" Content="Testitem 统计合并 Site"/>
                    <TextBlock Text="SBIN / HBIN Map" Margin="0,10,0,6"/>
                    <WrapPanel>
                        <CheckBox x:Name="ReportBinNumbers" Content="显示 BIN 数字" Margin="0,0,18,4"/>
                        <CheckBox x:Name="ReportSiteBorders" Content="显示 Site 加粗边框" Margin="0,0,0,4"/>
                    </WrapPanel>
                    <TextBlock x:Name="ReportFocusInfo" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DimGray"/>
                </StackPanel>
            </GroupBox>
            <TextBlock x:Name="TxtError" Foreground="Firebrick" Margin="0,8,0,8" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" Width="85" Padding="8,5"/>
                <Button Content="选择保存位置…" Click="BtnExport_Click" Padding="12,5" Margin="8,0,0,0" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
        <GroupBox Header="1. 勾选需要导出的晶圆">
            <DockPanel Margin="10">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="全选" Click="SelectAll_Click" Padding="10,3"/>
                    <Button Content="全不选" Click="SelectNone_Click" Padding="10,3" Margin="8,0,0,0"/>
                </StackPanel>
                <ListBox x:Name="WaferList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name, Mode=OneTime}" Margin="4"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>
    </DockPanel>
</Window>
