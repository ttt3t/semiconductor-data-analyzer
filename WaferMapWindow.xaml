<Window x:Class="SemiconductorCsvAnalyzer.WaferMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SemiconductorCsvAnalyzer.Controls"
        Title="Wafer Map" Width="1120" Height="720" MinWidth="900" MinHeight="540"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="8,8,0,8">
            <TextBlock Text="Wafer" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,8"/>
            <!-- Keep wafer selection in this window; a ComboBox creates a native popup. -->
            <ListBox x:Name="WaferList" SelectionChanged="Wafer_Changed"
                     SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="6,8"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding WaferId, Mode=OneTime}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Column="1" BorderBrush="#CCC" BorderThickness="1" Margin="8">
            <Grid ClipToBounds="True">
                <controls:WaferMapControl x:Name="Map"
                                          ShowBinNumbers="{Binding IsChecked, ElementName=ChkBinNumbers}"
                                          ShowSiteBorders="{Binding IsChecked, ElementName=ChkSiteBorders}"/>
                <!-- A separate layer avoids both native popup windows and redrawing the dies on hover. -->
                <Canvas x:Name="HoverLayer" IsHitTestVisible="False">
                    <Border x:Name="HoverInfo" Visibility="Collapsed" Background="#FFFFF4"
                            BorderBrush="#888" BorderThickness="1" CornerRadius="3" Padding="8">
                        <TextBlock x:Name="HoverText" TextWrapping="Wrap" MaxWidth="340" Foreground="#222"/>
                    </Border>
                </Canvas>
            </Grid>
        </Border>

        <Grid Grid.Column="2" Margin="0,8,8,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="TxtTitle" Grid.Row="0"
                       FontWeight="Bold" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap"/>

            <TextBlock x:Name="TxtMapInfo" Grid.Row="1" Foreground="DimGray"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>

            <CheckBox x:Name="ChkBinNumbers" Grid.Row="2" Content="显示 BIN 数字"
                      IsChecked="False" Visibility="Collapsed" Margin="0,0,0,12"/>

            <CheckBox x:Name="ChkSiteBorders" Grid.Row="3" Content="显示 Site 加粗边框"
                      IsChecked="False" Margin="0,0,0,12"/>

            <StackPanel x:Name="ModePanel" Grid.Row="4" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock Text="绘图模式" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="PfMode" Content="P/F" IsChecked="True" GroupName="MapMode" Checked="MapMode_Changed"/>
                    <RadioButton x:Name="HeatMode" Content="热力图" GroupName="MapMode" Checked="MapMode_Changed" Margin="20,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer x:Name="HeatLegend" Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Margin="0,0,0,12">
            <StackPanel>
                <RadioButton x:Name="SigmaRangeMode" Content="均值 ± Nσ" GroupName="HeatRange" IsChecked="True"
                             Checked="HeatRangeMode_Changed" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="N =" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtHeatSigma" Text="6" Width="60" Padding="4,2" Margin="6,0"/>
                    <Button Content="应用范围" Click="HeatRangeMode_Changed" Padding="6,2"/>
                </StackPanel>
                <RadioButton x:Name="MinMaxRangeMode" Content="最小值 / 均值 / 最大值" GroupName="HeatRange"
                             Checked="HeatRangeMode_Changed" Margin="0,0,0,8"/>
                <RadioButton x:Name="CustomRangeMode" Content="自定义蓝 / 绿 / 红色标" GroupName="HeatRange" Checked="HeatRangeMode_Changed" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="蓝标" Foreground="#235FDC" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtHeatBlue" Grid.Column="1" Padding="4,2" Margin="0,0,0,5" AutomationProperties.Name="蓝色色标数值"/>
                    <TextBlock Grid.Row="1" Text="绿标" Foreground="#2EA043" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtHeatGreen" Grid.Row="1" Grid.Column="1" Padding="4,2" Margin="0,0,0,5" AutomationProperties.Name="绿色色标数值"/>
                    <TextBlock Grid.Row="2" Text="红标" Foreground="#DC3737" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtHeatRed" Grid.Row="2" Grid.Column="1" Padding="4,2" AutomationProperties.Name="红色色标数值"/>
                </Grid>
                <Button Content="应用自定义色标" Click="ApplyCustomRange_Click" HorizontalAlignment="Left" Padding="6,2" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtHeatError" Foreground="Firebrick" TextWrapping="Wrap"/>
                <TextBlock Text="蓝标 → 绿标 → 红标" Margin="0,0,0,8"/>
                <Rectangle Height="18" Margin="0,0,0,10">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#235FDC" Offset="0"/>
                            <GradientStop Color="#2EA043" Offset="0.5"/>
                            <GradientStop Color="#DC3737" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock x:Name="TxtHeatRange" TextWrapping="Wrap" LineHeight="22"/>
                
            </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="6">
                <Button x:Name="BtnCopyMapTable" Content="复制 Map 表格" IsEnabled="False"
                        Click="BtnCopyMapTable_Click" Margin="0,0,0,8" Padding="8,4"
                        AutomationProperties.Name="复制 Map 表格"
                        ToolTip="复制当前晶圆的坐标表格，可粘贴到 Excel；SBIN/HBIN 填编号，P/F 填 P 或 F，无效测量填 E，空坐标留空"/>
                <Button x:Name="BtnCopyLegend" Content="复制图例"
                        Click="BtnCopyLegend_Click" Margin="0,0,0,8" Padding="8,4"/>
                <TextBlock x:Name="TxtCopyStatus" Foreground="DimGray" TextWrapping="Wrap"/>
            </StackPanel>

            <DataGrid x:Name="DgLegend" Grid.Row="5"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      ClipboardCopyMode="IncludeHeader"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F5F5F5">
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="BinVisibilityColumn" Header="显示" Width="42" Visibility="Collapsed" CanUserSort="False">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <EventSetter Event="Click" Handler="BinVisibilityHeader_Click"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <CheckBox IsChecked="{Binding IsDisplayed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      AutomationProperties.Name="显示 BIN 原色" AutomationProperties.HelpText="取消勾选将此 BIN 显示为灰色；点击显示列头全选或取消全选，不改变统计"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" SortMemberPath="Color" CanUserSort="False" Width="22">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Rectangle Width="14" Height="14" Fill="{Binding Color, Mode=OneTime}" Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Bin"  Binding="{Binding Category, Mode=OneTime}" Width="60"/>
                    <DataGridTextColumn Header="数量" Binding="{Binding Count, Mode=OneTime}" Width="45"/>
                    <DataGridTextColumn Header="占比%" Binding="{Binding Percent, Mode=OneTime, StringFormat=F2}" Width="58"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
