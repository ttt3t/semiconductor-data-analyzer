<Window x:Class="SemiconductorCsvAnalyzer.StdfLotInformationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STDF Lot Information" Width="1130" Height="740" MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12"
        Background="{DynamicResource WorkspaceBackground}" Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/WorkspaceTheme.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style TargetType="DataGrid">
                <Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="MinRowHeight" Value="28"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F7"/><Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
                <Setter Property="AlternatingRowBackground" Value="#F7F9FC"/><Setter Property="MinColumnWidth" Value="65"/>
                <Setter Property="ClipboardCopyMode" Value="IncludeHeader"/><Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            </Style>
            <DataTemplate x:Key="FieldValue"><TextBlock Text="{Binding Value}" TextWrapping="Wrap" ToolTip="{Binding Value}" Padding="3,2"/></DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtnRefresh" Content="重新读取" Click="Refresh_Click" Style="{StaticResource WorkspaceButton}" Margin="0,0,8,0" IsEnabled="False"/>
                <Button x:Name="BtnCopy" Content="复制全部信息" Click="Copy_Click" Style="{StaticResource WorkspaceButton}" IsEnabled="False"/>
            </StackPanel>
            <StackPanel><TextBlock Text="STDF Lot Information" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230" MinWidth="150"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="440"/></Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock x:Name="TxtSourceCount" DockPanel.Dock="Top" Text="STDF 文件" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ListBox x:Name="LstFiles" SelectionChanged="File_Changed" BorderBrush="{StaticResource BorderSoft}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,6" ToolTip="{Binding Path}">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Directory}" Foreground="{StaticResource TextSecondary}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock x:Name="TxtSummary" FontSize="15" FontWeight="SemiBold" Text="尚未选择 STDF" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtPath" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <TabControl>
                    <TabItem Header="Lot / 批次信息">
                        <DataGrid x:Name="DgLot" Margin="0,6,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="记录" Binding="{Binding Record}" Width="65"/>
                                <DataGridTextColumn Header="字段" Binding="{Binding Name}" Width="125"/>
                                <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="150"/>
                                <DataGridTemplateColumn Header="原始值" CellTemplate="{StaticResource FieldValue}" Width="*" MinWidth="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem x:Name="WaferTab" Header="Wafer / 晶圆信息">
                        <DockPanel Margin="0,8,0,0">
                            <ListBox x:Name="LstWafers" DockPanel.Dock="Top" DisplayMemberPath="Name" SelectionChanged="Wafer_Changed" MaxHeight="120" Margin="0,0,0,8"/>
                            <DataGrid x:Name="DgWafer">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="记录" Binding="{Binding Record}" Width="65"/>
                                    <DataGridTextColumn Header="字段" Binding="{Binding Name}" Width="125"/>
                                    <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="150"/>
                                    <DataGridTemplateColumn Header="原始值" CellTemplate="{StaticResource FieldValue}" Width="*" MinWidth="180"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
            
        </StackPanel>
    </Grid>
</Window>
