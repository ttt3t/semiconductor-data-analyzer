<Window x:Class="SemiconductorCsvAnalyzer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="840" Height="750" MinWidth="680" MinHeight="560"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="{DynamicResource WorkspaceBackground}" Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,0,0,14"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,18"/>
            </Style>
            <Style x:Key="HelpText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="LineHeight" Value="23"/>
            </Style>
            <Style TargetType="TabItem">
                <Setter Property="Padding" Value="14,9"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,3,0">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="White"/>
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#D9E3F2"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#EFF6FF"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#2563EB"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="24">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold"/>
                
            </StackPanel>
            <StackPanel x:Name="ConfigActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="加载配置…" Click="BtnLoad_Click" Style="{StaticResource WorkspaceButton}"/>
                <Button Content="导出 config.ini…" Click="BtnExport_Click" Style="{StaticResource WorkspaceButton}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSettingsClose" Content="关闭" Click="SettingsClose_Click" MinWidth="88" Style="{StaticResource WorkspaceButton}"/>
                <Button x:Name="BtnApplyAnalysis" Content="应用分析配置并重算" Click="BtnApply_Click" MinWidth="156" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
        <TabControl x:Name="SettingsTabs" SelectionChanged="SettingsTabs_SelectionChanged"
                    BorderBrush="{StaticResource BorderSoft}" Background="{StaticResource SurfaceBrush}">
            <TabItem x:Name="AnalysisTab" Header="统计与绘图">
                <ScrollViewer TextElement.Foreground="{StaticResource TextPrimary}" TextElement.FontWeight="Normal" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="稳健统计" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="ChkRemoveOutliers" Content="计算 Robust Mean / Sigma 时剔除离群点" IsChecked="True"
                                  Checked="AnalysisControlChanged" Unchecked="AnalysisControlChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="保留范围：原始均值 ±" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtOutlierSigma" Text="6" Width="80" Margin="10,0" TextChanged="AnalysisTextChanged"
                                     IsEnabled="{Binding IsChecked, ElementName=ChkRemoveOutliers}"/>
                            <TextBlock Text="σ" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="0,22"/>
                        <TextBlock Text="直方图" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="210"/><ColumnDefinition Width="24"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <TextBlock Text="默认模式" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbHistogramMode" Grid.Column="1" Padding="8,6" SelectionChanged="AnalysisSelectionChanged">
                                <ComboBoxItem Content="固定等宽" Tag="Fixed"/>
                                <ComboBoxItem Content="规格区间" Tag="SpecZone"/>
                                <ComboBoxItem Content="中位数中心" Tag="MedianCentered"/>
                            </ComboBox>
                            <TextBlock Grid.Column="3" Text="分箱数量" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtBinCount" Grid.Column="4" TextChanged="AnalysisTextChanged"/>
                        </Grid>
                        <WrapPanel>
                            <CheckBox x:Name="ChkShowLowLimit" Content="下限 LSL" Margin="0,0,28,14" Checked="AnalysisControlChanged" Unchecked="AnalysisControlChanged"/>
                            <CheckBox x:Name="ChkShowHighLimit" Content="上限 USL" Margin="0,0,28,14" Checked="AnalysisControlChanged" Unchecked="AnalysisControlChanged"/>
                            <CheckBox x:Name="ChkShowMean" Content="均值" Margin="0,0,28,14" Checked="AnalysisControlChanged" Unchecked="AnalysisControlChanged"/>
                            <CheckBox x:Name="ChkShowThreeSigma" Content="±3σ 参考线" Checked="AnalysisControlChanged" Unchecked="AnalysisControlChanged"/>
                        </WrapPanel>
                        
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="IdentityTab" Header="CP / FT">
                <ScrollViewer TextElement.Foreground="{StaticResource TextPrimary}" TextElement.FontWeight="Normal" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="测试与复测识别模式" Style="{StaticResource SectionTitle}"/>
                        <RadioButton x:Name="ModeCP" Content="CP（默认）：沿用晶圆、坐标和原序列号识别" GroupName="TestMode" Margin="0,0,0,14" Checked="IdentityControlChanged"/>
                        <RadioButton x:Name="ModeFT" Content="FT：读取 eFuse / OTP 芯片 UUID 识别复测" GroupName="TestMode" Margin="0,0,0,18" Checked="IdentityControlChanged"/>
                        
                        <StackPanel x:Name="FtIdentityPanel" Margin="0,22,0,0">
                            <StackPanel.Style><Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=ModeFT}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></StackPanel.Style>
                            <TextBlock Text="eFuse / OTP UUID" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Test Num（多个按填写顺序拼接，以逗号分隔）" Margin="0,0,0,8"/>
                            <TextBox x:Name="TxtUuidTestNumbers" TextChanged="IdentityTextChanged" Margin="0,0,0,12"/>
                            <Button Content="配置 / 预览芯片 UUID…" Click="BtnUuid_Click" HorizontalAlignment="Left" Style="{StaticResource WorkspaceButton}" Margin="0,0,0,14"/>
                            
                        </StackPanel>
                        
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="AppearanceTab" Header="界面与习惯">
                <ScrollViewer TextElement.Foreground="{StaticResource TextPrimary}" TextElement.FontWeight="Normal" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="主列表" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="ChkCompactTable" Content="紧凑行高（适合同时查看更多测项）"/>
                        <CheckBox x:Name="ChkShowColumnFilters" Content="显示表头的关键字筛选输入框"/>
                        <CheckBox x:Name="ChkAlternateRows" Content="显示交替行底色"/>
                        
                        <TextBlock Text="Run 选取方式" Style="{StaticResource SectionTitle}" Margin="0,18,0,10"/>
                        <RadioButton x:Name="RunBySerial" Content="序列号" GroupName="RunSelection" Margin="0,0,0,10"/>
                        <RadioButton x:Name="RunByCoordinates" Content="晶圆 + X/Y 坐标" GroupName="RunSelection"/>
                        
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="0,22"/>
                        <TextBlock Text="导入习惯" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="STDF 默认模式" VerticalAlignment="Center" Width="132"/>
                            <ComboBox x:Name="CmbDefaultStdfMode" Width="240" Padding="8,6">
                                <ComboBoxItem Content="普通模式"/>
                                <ComboBoxItem Content="93k 模式（优先 TSR 名称）"/>
                            </ComboBox>
                        </StackPanel>
                        

                        <Button x:Name="BtnSavePreferences" Content="保存界面设置" Click="BtnSavePreferences_Click"
                                HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="CsvFormatTab" Header="CSV 格式">
                <Grid TextElement.Foreground="{StaticResource TextPrimary}" TextElement.FontWeight="Normal" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button x:Name="BtnBrowseCsvFormat" DockPanel.Dock="Right" Content="选择 CSV…" Click="BrowseCsvFormat_Click" Style="{StaticResource WorkspaceButton}" Margin="8,0,0,0"/>
                        <TextBox x:Name="TxtCsvSamplePath" TextChanged="CsvSamplePath_Changed" ToolTip="仅选择文件不会自动识别；点击开始识别后运行。"/>
                    </DockPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button x:Name="BtnRecognizeCsv" Content="开始识别" Click="RecognizeCsv_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6"/>
                        <Button x:Name="BtnCancelCsvDetection" Content="取消识别" Click="CancelCsvDetection_Click" IsEnabled="False" Style="{StaticResource WorkspaceButton}" Margin="0,0,8,6"/>
                        <Button x:Name="BtnPreviewCsvFormat" Content="更新预览" Click="PreviewCsvFormat_Click" IsEnabled="False" Style="{StaticResource WorkspaceButton}" Margin="0,0,8,6"/>
                        <Button x:Name="BtnUseCsvFormat" Content="采用此配置" Click="UseCsvFormat_Click" IsEnabled="False" Style="{StaticResource WorkspaceButton}" Margin="0,0,8,6"/>
                        <Button x:Name="BtnSaveCsvFormat" Content="INI 另存为…" Click="SaveCsvFormat_Click" IsEnabled="False" Style="{StaticResource WorkspaceButton}" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock x:Name="TxtCsvFormatSummary" Grid.Row="2" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="3" MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <TextBlock x:Name="TxtCsvFormatWarnings" TextWrapping="Wrap" Foreground="#92400E"/>
                    </ScrollViewer>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <GroupBox Header="样本预览（测项列优先）" BorderBrush="{StaticResource BorderSoft}">
                            <DataGrid x:Name="DgCsvFormatPreview" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      AutoGeneratingColumn="CsvPreview_AutoGeneratingColumn" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling" ColumnWidth="100" RowHeight="25" FontSize="12"/>
                        </GroupBox>
                        <GroupBox Grid.Column="2" Header="识别后的 INI（可编辑）" BorderBrush="{StaticResource BorderSoft}">
                            <TextBox x:Name="TxtDetectedCsvIni" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" AcceptsTab="True"
                                     TextChanged="DetectedCsvIni_Changed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" SpellCheck.IsEnabled="False" Padding="8"
                                     ToolTip="TestItemRows=1,2 指定多行名称；TestItemColumns 可指定测项列；SkipRepeatedHeaders 控制跳过重复表头。"/>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="SBinDescriptionTab" Header="SBIN 释义">
                <DockPanel Margin="20">
                    <TextBlock DockPanel.Dock="Top" Text="每行填写 SBIN=释义，例如 2=开路。应用后显示在 BIN / Wafer Table，分类规则保持独立。"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtSBinDescriptions" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="SBinDescriptions_Changed"/>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="IniTab" Header="INI 配置">
                <DockPanel TextElement.Foreground="{StaticResource TextPrimary}" TextElement.FontWeight="Normal" Margin="18">
                    
                    <TextBox x:Name="TxtConfig" FontFamily="Consolas" FontSize="13" AcceptsReturn="True"
                             AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" Padding="12" SpellCheck.IsEnabled="False"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="最近文件">
                <Grid TextElement.Foreground="{StaticResource TextPrimary}" TextElement.FontWeight="Normal" Margin="18">
                    <Grid.Resources>
                        <DataTemplate x:Key="RecentFileTemplate">
                            <StackPanel Margin="6">
                                <TextBlock Text="{Binding Name, Mode=OneTime}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding FilePath, Mode=OneTime}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding Status, Mode=OneTime}" Foreground="Firebrick"/>
                            </StackPanel>
                        </DataTemplate>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <GroupBox Header="最近的 Config" Margin="0,0,0,14" BorderBrush="{StaticResource BorderSoft}">
                        <DockPanel Margin="10">
                            <Button Content="应用选中配置并重算" DockPanel.Dock="Bottom" Click="BtnRecentConfig_Click" Style="{StaticResource WorkspaceButton}" Margin="0,8,0,0"/>
                            <ListBox x:Name="RecentConfigs" ItemTemplate="{StaticResource RecentFileTemplate}"
                                     BorderBrush="{StaticResource BorderSoft}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="RecentConfig_DoubleClick"/>
                        </DockPanel>
                    </GroupBox>
                    <GroupBox Header="最近的数据（CSV / STDF）" Grid.Row="1" BorderBrush="{StaticResource BorderSoft}">
                        <DockPanel Margin="10">
                            
                            <Button x:Name="BtnRecentCsv" Content="打开选中数据" DockPanel.Dock="Bottom" Click="BtnRecentCsv_Click" Style="{StaticResource WorkspaceButton}" Margin="0,8,0,0"/>
                            <ListBox x:Name="RecentCsvs" ItemTemplate="{StaticResource RecentFileTemplate}"
                                     BorderBrush="{StaticResource BorderSoft}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="RecentCsv_DoubleClick"/>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
