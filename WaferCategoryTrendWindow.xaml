<Window x:Class="SemiconductorCsvAnalyzer.WaferCategoryTrendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SemiconductorCsvAnalyzer.Controls"
        Title="晶圆不良分类趋势" Width="1240" Height="760" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WorkspaceBackground}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="晶圆不良分类趋势" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock x:Name="TxtMode" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="8" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="显示分类" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="TxtSelection" Margin="0,5,0,9" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <Button Content="全选" Click="SelectAll_Click" Style="{StaticResource WorkspaceButton}" Padding="12,4" Margin="0,0,6,0"/>
                            <Button Content="清空" Click="SelectNone_Click" Style="{StaticResource WorkspaceButton}" Padding="12,4"/>
                        </StackPanel>
                    </StackPanel>
                    <ListBox x:Name="CategoryChoices" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0,5"/>
                                <Setter Property="Template">
                                    <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center">
                                    <DockPanel Margin="4,0,0,0">
                                        <Rectangle Fill="{Binding LineBrush}" Height="3" Width="20" Margin="0,0,7,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding Category}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                                    </DockPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="ChartRow" Height="3*" MinHeight="180"/>
                        <RowDefinition Height="7"/>
                        <RowDefinition x:Name="TableRow" Height="2*" MinHeight="135"/>
                    </Grid.RowDefinitions>
                    <controls:WaferCategoryTrendControl x:Name="TrendChart"/>
                    <GridSplitter Grid.Row="1" Height="7" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext" Background="#F1F5F9"/>
                    <DataGrid x:Name="DgTrend" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              CanUserResizeColumns="False" CanUserSortColumns="False" FrozenColumnCount="1"
                              HeadersVisibility="Column" ColumnHeaderHeight="44" RowHeight="32"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True" ScrollViewer.ScrollChanged="Table_ScrollChanged" SizeChanged="Table_SizeChanged"
                              SelectionUnit="FullRow" ClipboardCopyMode="IncludeHeader" BorderThickness="1"
                              BorderBrush="#E2E8F0" GridLinesVisibility="All" HorizontalGridLinesBrush="#E2E8F0"
                              VerticalGridLinesBrush="#E2E8F0" Background="White" AlternatingRowBackground="#F8FAFC">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="6,3"/>
                                <Setter Property="ContentTemplate">
                                    <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="38"/></DataTemplate></Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="分类" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="10,0" VerticalAlignment="Center">
                                            <Rectangle Width="22" Height="3" Fill="{Binding LineBrush}" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding Category}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.ClipboardContentBinding><Binding Path="Category"/></DataGridTemplateColumn.ClipboardContentBinding>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
        
    </Grid>
</Window>
