<UserControl x:Class="SemiconductorCsvAnalyzer.Controls.WaferMapTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SemiconductorCsvAnalyzer.Controls">
    <Border x:Name="Frame" BorderBrush="#E2E8F0" BorderThickness="1" Background="White" Margin="2" Padding="2">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="YieldText" FontSize="10" Foreground="#64748B" TextAlignment="Center" Margin="0,1,0,1"/>
            <local:WaferMapControl x:Name="TileMap" Compact="True"/>
        </StackPanel>
    </Border>
</UserControl>
