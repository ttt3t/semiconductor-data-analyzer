<Window x:Class="SemiconductorCsvAnalyzer.WaferTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wafer Table" Width="1380" Height="720" MinWidth="880" MinHeight="440"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="MinColumnWidth" Value="60"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="ClipboardCopyMode" Value="IncludeHeader"/>
            <Setter Property="AlternatingRowBackground" Value="#F5F5F5"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,0,0,10">
                <Button Content="复制全部（3 个表）" Click="BtnCopyAll_Click" DockPanel.Dock="Right" Padding="12,5"/>
                <Button x:Name="BtnCategoryTrend" Content="不良分类趋势" Click="BtnCategoryTrend_Click"
                        DockPanel.Dock="Right" Padding="12,5" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtCopyStatus" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="DimGray" Margin="10,0"/>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="复测模式：" VerticalAlignment="Center"/>
                    <RadioButton x:Name="FirstMode" GroupName="Retest" Content="只保留首测" Checked="Mode_Changed" Margin="8,4,20,4"/>
                    <RadioButton x:Name="LastMode" GroupName="Retest" Content="复测覆盖首测" IsChecked="True" Checked="Mode_Changed" Margin="0,4,24,4"/>
                    <TextBlock Text="显示：" VerticalAlignment="Center"/>
                    <RadioButton x:Name="PercentMode" GroupName="Display" Content="占比（%）" IsChecked="True" Checked="Mode_Changed" Margin="8,4,20,4"/>
                    <RadioButton x:Name="CountMode" GroupName="Display" Content="数量（颗）" Checked="Mode_Changed" Margin="0,4"/>
                </WrapPanel>
            </DockPanel>
            <TextBlock x:Name="TxtInfo" Margin="0,0,0,10" TextWrapping="Wrap"/>
        </StackPanel>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SbinPanelColumn" Width="1.15*" MinWidth="260"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition x:Name="OtherPanelsColumn" Width="2*" MinWidth="410"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="SBIN 各 Wafer" FontWeight="Bold" Margin="0,0,0,8"/>
                <DataGrid x:Name="DgWafers" FrozenColumnCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SBIN" Binding="{Binding Bin, Mode=OneTime}" SortMemberPath="BinSort" Width="75"/>
                        <DataGridTextColumn Header="分类" Binding="{Binding Category, Mode=OneTime}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#E4E4E4"/>
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HbinPanelColumn" Width="*" MinWidth="195"/>
                    <ColumnDefinition Width="7"/>
                    <ColumnDefinition x:Name="CategoryPanelColumn" Width="*" MinWidth="195"/>
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="HBIN 各 Wafer" FontWeight="Bold" Margin="0,0,0,8"/>
                    <DataGrid x:Name="DgHBinWafers" FrozenColumnCount="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="HBIN" Binding="{Binding Bin, Mode=OneTime}" SortMemberPath="BinSort" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#E4E4E4"/>
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="SBIN 分类各 Wafer" FontWeight="Bold" Margin="0,0,0,8"/>
                    <DataGrid x:Name="DgCategoryWafers" FrozenColumnCount="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="分类" Binding="{Binding Category, Mode=OneTime}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
