<Window x:Class="SemiconductorCsvAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SemiconductorCsvAnalyzer.Controls"
        Title="CSV Analyzer · V2.0" Height="850" Width="1440" MinWidth="900" MinHeight="680"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12"
        Background="{DynamicResource WorkspaceBackground}" Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/WorkspaceTheme.xaml"/></ResourceDictionary.MergedDictionaries>
            <controls:YieldHeatBrushConverter x:Key="YieldHeatBrush"/>
            <Style x:Key="ColFilterBox" TargetType="TextBox">
                <Setter Property="Margin" Value="0,3,0,0"/><Setter Property="Padding" Value="3,0"/>
                <Setter Property="Height" Value="17"/><Setter Property="MinHeight" Value="17"/>
                <Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderBrush" Value="#D7E0ED"/><Setter Property="Background" Value="White"/>
            </Style>
            <Style x:Key="ColHeaderLabel" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>
            <Style x:Key="ButtonIcon" TargetType="controls:ActionIcon">
                <Setter Property="Width" Value="15"/><Setter Property="Height" Value="15"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
                <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Style>
            <Style x:Key="ToolbarAction" TargetType="Button" BasedOn="{StaticResource QuietButton}">
                <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Padding" Value="3,5"/>
                <Setter Property="Margin" Value="0,0,1,0"/>
            </Style>
            <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="5,5"/><Setter Property="Margin" Value="0,0,1,0"/>
            </Style>
            <Style x:Key="CommandGroup" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/><Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="2,1"/>
                <Setter Property="Margin" Value="0,0,3,0"/>
            </Style>
            <Style x:Key="GroupLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="8,0,0,3"/>
            </Style>
            <Style x:Key="SiteToggle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="Padding" Value="9,5"/>
                <Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SiteSurface" Background="#F5F7FA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="SiteSurface" Property="Background" Value="#EAF1FF"/><Setter TargetName="SiteSurface" Property="BorderBrush" Value="#C8DAFE"/><Setter Property="Foreground" Value="#1D4ED8"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SiteSurface" Property="BorderBrush" Value="#93B4F8"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SiteSurface" Property="BorderBrush" Value="#2563EB"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <Border x:Name="MainToolbar" DockPanel.Dock="Top" Background="{StaticResource WorkspaceBackground}" Padding="8,5,4,4">
            <DockPanel>
                <WrapPanel x:Name="CommandGroups">
                    <Border Style="{StaticResource CommandGroup}"><StackPanel>
                        
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="OpenDataButton" Click="BtnOpenCsv_Click" Style="{StaticResource PrimaryAction}"><StackPanel Orientation="Horizontal"><controls:ActionIcon Kind="Open" Style="{StaticResource ButtonIcon}"/><TextBlock Text="打开文件" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button x:Name="ImportDataButton" Click="BtnImportData_Click" Style="{StaticResource ToolbarAction}"><StackPanel Orientation="Horizontal"><controls:ActionIcon Kind="Import" Style="{StaticResource ButtonIcon}"/><TextBlock Text="追加导入" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button x:Name="ExportDataButton" Click="BtnExportData_Click" Style="{StaticResource ToolbarAction}"><StackPanel Orientation="Horizontal"><controls:ActionIcon Kind="Export" Style="{StaticResource ButtonIcon}"/><TextBlock Text="导出数据" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button x:Name="ExportReportButton" Click="BtnExportReport_Click" Style="{StaticResource ToolbarAction}"><StackPanel Orientation="Horizontal"><controls:ActionIcon Kind="Report" Style="{StaticResource ButtonIcon}"/><TextBlock Text="XLSX 报告" VerticalAlignment="Center"/></StackPanel></Button>
                        </StackPanel>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CommandGroup}"><StackPanel>
                        
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SbinMapButton" Click="BtnSbinMap_Click" Style="{StaticResource ToolbarAction}"><StackPanel Orientation="Horizontal"><controls:ActionIcon Kind="Map" Style="{StaticResource ButtonIcon}"/><TextBlock Text="SBIN" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button x:Name="HbinMapButton" Click="BtnHbinMap_Click" Style="{StaticResource ToolbarAction}"><StackPanel Orientation="Horizontal"><controls:ActionIcon Kind="Wafer" Style="{StaticResource ButtonIcon}"/><TextBlock Text="HBIN" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button x:Name="PfMapButton" Click="BtnPfMap_Click" Style="{StaticResource ToolbarAction}"><StackPanel Orientation="Horizontal"><controls:ActionIcon Kind="Heatmap" Style="{StaticResource ButtonIcon}"/><TextBlock Text="P/F" VerticalAlignment="Center"/></StackPanel></Button>
                        </StackPanel>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CommandGroup}"><StackPanel>
                        
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BinTableButton" Click="BtnBinStats_Click" Style="{StaticResource ToolbarAction}"><StackPanel Orientation="Horizontal"><controls:ActionIcon Kind="Table" Style="{StaticResource ButtonIcon}"/><TextBlock Text="BIN Table" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button x:Name="WaferTableButton" Click="BtnWaferTable_Click" Style="{StaticResource ToolbarAction}"><StackPanel Orientation="Horizontal"><controls:ActionIcon Kind="Table" Style="{StaticResource ButtonIcon}"/><TextBlock Text="Wafer Table" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button x:Name="PredictionButton" Click="BtnYieldSimulation_Click" Style="{StaticResource ToolbarAction}"><StackPanel Orientation="Horizontal"><controls:ActionIcon Kind="Prediction" Style="{StaticResource ButtonIcon}"/><TextBlock Text="良率预测" VerticalAlignment="Center"/></StackPanel></Button>
                        </StackPanel>
                    </StackPanel></Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SettingsButton" Click="BtnSettings_Click" Style="{StaticResource ToolbarAction}" ToolTip="设置" AutomationProperties.Name="设置"><controls:ActionIcon Kind="Settings" Width="17" Height="17"/></Button>
                        <Button x:Name="AboutButton" Click="BtnAbout_Click" Style="{StaticResource ToolbarAction}" ToolTip="关于与详细说明" AutomationProperties.Name="关于"><controls:ActionIcon Kind="Info" Width="17" Height="17"/></Button>
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>
        <Border x:Name="FileContextBar" DockPanel.Dock="Top" Margin="8,0,8,0" Padding="8,3" Background="White" CornerRadius="7" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto" MaxWidth="330"/></Grid.ColumnDefinitions>
                <DockPanel>
                    <controls:ActionIcon Kind="File" Width="14" Height="14" Margin="0,0,7,0"/>
                    <TextBlock Text="当前数据  " Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCsvName" Text="尚未打开文件" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel Grid.Column="2">
                    <TextBlock Text="配置  " Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtConfigName" TextTrimming="CharacterEllipsis" Foreground="#475569" FontSize="11" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource WorkspaceBackground}" Padding="14,5" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtBottomInfo" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtStatus" Grid.Column="2" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
            </Grid>
        </Border>
        <Grid x:Name="MainContent" ClipToBounds="True" Margin="8,6,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MainListColumn" Width="1.08*" MinWidth="360"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition x:Name="ChartsColumn" Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="9" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
            <DockPanel ClipToBounds="True">
                <StackPanel DockPanel.Dock="Top" Margin="8,5,8,3">
                    <WrapPanel>
                        <ToggleButton x:Name="BtnCombineSite" Click="BtnCombineSite_Click" Style="{StaticResource SiteToggle}" Margin="0,0,10,3">
                            <StackPanel Orientation="Horizontal"><controls:ActionIcon Kind="Combine" Width="14" Height="14" Margin="0,0,5,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/><TextBlock Text="Combine Site"/></StackPanel>
                        </ToggleButton>
                        <ListBox x:Name="LstRetestMode" SelectedIndex="0" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="RetestMode_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="复测统计口径" ItemContainerStyle="{StaticResource SegmentOption}">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBoxItem Content="首测与复测均保留"/><ListBoxItem Content="只保留首测"/><ListBoxItem Content="复测覆盖首测"/>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="5,0,3,3" VerticalAlignment="Center">
                            <TextBlock Text="Run" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                            <Grid x:Name="RunSelector" IsEnabled="False" Height="26">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="RunTextBox" VerticalContentAlignment="Center" Padding="4,0" BorderBrush="#D7E0ED"
                                         KeyDown="RunTextBox_KeyDown" LostKeyboardFocus="RunTextBox_LostKeyboardFocus" AutomationProperties.Name="Run 序列号"/>
                                <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <RepeatButton x:Name="NextRunButton" Content="▴" Padding="0" FontSize="9" Click="NextRun_Click" Delay="350" Interval="100" AutomationProperties.Name="下一条 Run"/>
                                    <RepeatButton x:Name="PreviousRunButton" Grid.Row="1" Content="▾" Padding="0" FontSize="9" Click="PreviousRun_Click" Delay="350" Interval="100" AutomationProperties.Name="上一条 Run"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                        <Button x:Name="ValueTableButton" Click="BtnShowValues_Click" Style="{StaticResource ToolbarAction}" Margin="0,0,0,3"><StackPanel Orientation="Horizontal"><controls:ActionIcon Kind="Table" Style="{StaticResource ButtonIcon}"/><TextBlock Text="原始值" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="CopyStatsButton" Click="BtnCopyAllStats_Click" Style="{StaticResource ToolbarAction}" Margin="0,0,0,3"><StackPanel Orientation="Horizontal"><controls:ActionIcon Kind="Copy" Style="{StaticResource ButtonIcon}"/><TextBlock Text="复制" VerticalAlignment="Center"/></StackPanel></Button>
                    </WrapPanel>
                </StackPanel>
                <Border x:Name="BusyIndicator" DockPanel.Dock="Bottom" Visibility="Collapsed" Height="34" Background="#EFF6FF">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path x:Name="BusySpinner" Data="M 10,2 A 8,8 0 1 1 2,10" Width="20" Height="20" Stroke="#2563EB" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Path.RenderTransform><RotateTransform CenterX="10" CenterY="10"/></Path.RenderTransform>
                            <Path.Style><Style TargetType="Path"><Style.Triggers><Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions><BeginStoryboard x:Name="Spin"><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><StopStoryboard BeginStoryboardName="Spin"/></Trigger.ExitActions>
                            </Trigger></Style.Triggers></Style></Path.Style>
                        </Path>
                        <TextBlock Text="处理中…" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="#426186"/>
                    </StackPanel>
                </Border>
                <controls:FastDataGrid x:Name="DgTestItems" BorderThickness="0" Background="White"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="True" CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserResizeRows="False"
                          SelectionMode="Single" SelectionChanged="DgTestItems_SelectionChanged"
                          PreviewMouseUp="TestItems_HeaderRightClick" PreviewMouseDoubleClick="DgTestItems_PreviewMouseDoubleClick"
                          HeadersVisibility="Column" ColumnHeaderHeight="44" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EDF1F6" AlternatingRowBackground="#F7F9FC" FontSize="12" RowHeight="22"
                          ClipToBounds="True" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          ScrollViewer.CanContentScroll="True" ScrollViewer.IsDeferredScrollingEnabled="True"
                          VirtualizingPanel.ScrollUnit="Item" VirtualizingPanel.CacheLength="1,1"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Resources><Style x:Key="SummaryCellText" TargetType="TextBlock">
                        <Setter Property="Margin" Value="4,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style x:Key="RunValueText" TargetType="TextBlock" BasedOn="{StaticResource SummaryCellText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RunValueFails, Mode=OneWay}" Value="True">
                                <Setter Property="Foreground" Value="#B91C1C"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="YieldHeatCell" TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="3,0"/>
                        <Setter Property="Foreground" Value="#1E293B"/>
                        <Setter Property="Background" Value="{Binding Mode=OneTime, Converter={StaticResource YieldHeatBrush}}"/>
                        <Style.Triggers><Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="BorderThickness" Value="1"/>
                        </Trigger></Style.Triggers>
                    </Style></DataGrid.Resources>
                    <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5FA"/><Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="6,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style></DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle><Style TargetType="DataGridRow">
                        <Style.Triggers><Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E8F0FF"/><Setter Property="Foreground" Value="#1E3A5F"/>
                        </Trigger></Style.Triggers>
                    </Style></DataGrid.RowStyle>
                    <DataGrid.CellStyle><Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="3,0"/>
                        <Style.Triggers><Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#DFEAFC"/><Setter Property="Foreground" Value="#1E3A5F"/>
                        </Trigger></Style.Triggers>
                    </Style></DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="FocusColumn" SortMemberPath="Data.Focus.IsFocused" CanUserSort="False" Width="45">
                            <DataGridTemplateColumn.Header><TextBlock Text="关注" ToolTip="双击表头：全选 / 取消当前筛选内的全部测试项"/></DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox DataContext="{Binding Data.Focus, Mode=OneTime}"
                                              IsChecked="{Binding IsFocused, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              PreviewMouseDoubleClick="Focus_PreviewMouseDoubleClick"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SummaryCellText}" Binding="{Binding TestNumberValue, Mode=OneTime}" SortMemberPath="TestNumberValue" Width="78">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="序号" Style="{StaticResource ColHeaderLabel}"/>
                                    <TextBox Style="{StaticResource ColFilterBox}" Tag="TestNumber"
                                             TextChanged="ColumnFilter_Changed"
                                             PreviewMouseLeftButtonDown="HeaderFilter_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SummaryCellText}" Binding="{Binding DisplayName, Mode=OneTime}" SortMemberPath="DisplayName" Width="150">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="测试项" Style="{StaticResource ColHeaderLabel}"/>
                                    <TextBox Style="{StaticResource ColFilterBox}" Tag="DisplayName"
                                             TextChanged="ColumnFilter_Changed"
                                             PreviewMouseLeftButtonDown="HeaderFilter_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SummaryCellText}" Binding="{Binding Site, Mode=OneTime}" SortMemberPath="SiteSort" Width="70">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Site" Style="{StaticResource ColHeaderLabel}"/>
                                    <TextBox Style="{StaticResource ColFilterBox}" Tag="Site"
                                             TextChanged="ColumnFilter_Changed"
                                             PreviewMouseLeftButtonDown="HeaderFilter_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SummaryCellText}" Binding="{Binding SBin, Mode=OneTime}" SortMemberPath="SBinSort" Width="55">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="SBIN" Style="{StaticResource ColHeaderLabel}"/>
                                    <TextBox Style="{StaticResource ColFilterBox}" Tag="SBin"
                                             TextChanged="ColumnFilter_Changed"
                                             PreviewMouseLeftButtonDown="HeaderFilter_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SummaryCellText}" Binding="{Binding HBin, Mode=OneTime}" SortMemberPath="HBinSort" Width="55">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="HBIN" Style="{StaticResource ColHeaderLabel}"/>
                                    <TextBox Style="{StaticResource ColFilterBox}" Tag="HBin"
                                             TextChanged="ColumnFilter_Changed"
                                             PreviewMouseLeftButtonDown="HeaderFilter_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SummaryCellText}" Binding="{Binding Unit, Mode=OneTime}" SortMemberPath="Unit" Width="50">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="单位" Style="{StaticResource ColHeaderLabel}"/>
                                    <TextBox Style="{StaticResource ColFilterBox}" Tag="Unit"
                                             TextChanged="ColumnFilter_Changed"
                                             PreviewMouseLeftButtonDown="HeaderFilter_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SummaryCellText}" Binding="{Binding LslText, Mode=OneTime}" SortMemberPath="LslSort" Width="70">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="LSL" Style="{StaticResource ColHeaderLabel}"/>
                                    <TextBox Style="{StaticResource ColFilterBox}" Tag="Lsl"
                                             TextChanged="ColumnFilter_Changed"
                                             PreviewMouseLeftButtonDown="HeaderFilter_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SummaryCellText}" Binding="{Binding UslText, Mode=OneTime}" SortMemberPath="UslSort" Width="70">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="USL" Style="{StaticResource ColHeaderLabel}"/>
                                    <TextBox Style="{StaticResource ColFilterBox}" Tag="Usl"
                                             TextChanged="ColumnFilter_Changed"
                                             PreviewMouseLeftButtonDown="HeaderFilter_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SummaryCellText}" Binding="{Binding Count, Mode=OneTime}" SortMemberPath="Count" Width="55">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Count" Style="{StaticResource ColHeaderLabel}"/>
                                    <TextBox Style="{StaticResource ColFilterBox}" Tag="Count"
                                             TextChanged="ColumnFilter_Changed"
                                             PreviewMouseLeftButtonDown="HeaderFilter_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SummaryCellText}" Binding="{Binding Eorr, Mode=OneTime}" SortMemberPath="Eorr" Width="60">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Eorr" Style="{StaticResource ColHeaderLabel}" ToolTip="当前测试项的空值、缺列、非数值及非有限值数量"/>
                                    <TextBox Style="{StaticResource ColFilterBox}" Tag="Eorr" TextChanged="ColumnFilter_Changed"
                                             PreviewMouseLeftButtonDown="HeaderFilter_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SummaryCellText}" Binding="{Binding SiteSigma, StringFormat=G6, TargetNullValue=-, Mode=OneTime}" SortMemberPath="SiteSigma" Width="75">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Site σ" Style="{StaticResource ColHeaderLabel}" ToolTip="Combine Site 时，各有有效数据的 Site 良率的总体标准差（百分点）；各 Site 等权"/>
                                    <TextBox Style="{StaticResource ColFilterBox}" Tag="SiteSigma" TextChanged="ColumnFilter_Changed"
                                             PreviewMouseLeftButtonDown="HeaderFilter_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SummaryCellText}" Binding="{Binding Mean, StringFormat=G6, Mode=OneTime}" SortMemberPath="Mean" Width="80">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Mean" Style="{StaticResource ColHeaderLabel}"/>
                                    <TextBox Style="{StaticResource ColFilterBox}" Tag="Mean"
                                             TextChanged="ColumnFilter_Changed"
                                             PreviewMouseLeftButtonDown="HeaderFilter_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="RunValueColumn" ElementStyle="{StaticResource RunValueText}" Binding="{Binding RunValue, StringFormat=G9, TargetNullValue=-, Mode=OneWay}" SortMemberPath="RunValue" Width="90">
                            <DataGridTextColumn.Header><StackPanel>
                                <TextBlock Text="Value" Style="{StaticResource ColHeaderLabel}" ToolTip="Run 对应的原始测量值；其他 Site、缺测或无效值显示 -"/>
                                <TextBox Style="{StaticResource ColFilterBox}" Tag="RunValue" TextChanged="ColumnFilter_Changed" PreviewMouseLeftButtonDown="HeaderFilter_PreviewMouseLeftButtonDown"/>
                            </StackPanel></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SummaryCellText}" Binding="{Binding Median, StringFormat=G6, TargetNullValue=-, Mode=OneTime}" SortMemberPath="Median" Width="80">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="中位数" Style="{StaticResource ColHeaderLabel}"/>
                                    <TextBox Style="{StaticResource ColFilterBox}" Tag="Median"
                                             TextChanged="ColumnFilter_Changed"
                                             PreviewMouseLeftButtonDown="HeaderFilter_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SummaryCellText}" Binding="{Binding Sigma, StringFormat=G6, Mode=OneTime}" SortMemberPath="Sigma" Width="70">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="σ" Style="{StaticResource ColHeaderLabel}"/>
                                    <TextBox Style="{StaticResource ColFilterBox}" Tag="Sigma"
                                             TextChanged="ColumnFilter_Changed"
                                             PreviewMouseLeftButtonDown="HeaderFilter_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SummaryCellText}" Binding="{Binding RobustMean, StringFormat=G6, TargetNullValue=-, Mode=OneTime}" SortMemberPath="RobustMean" Width="100">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Robust Mean" Style="{StaticResource ColHeaderLabel}"/>
                                    <TextBox Style="{StaticResource ColFilterBox}" Tag="RobustMean"
                                             TextChanged="ColumnFilter_Changed"
                                             PreviewMouseLeftButtonDown="HeaderFilter_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SummaryCellText}" Binding="{Binding RobustSigma, StringFormat=G6, TargetNullValue=-, Mode=OneTime}" SortMemberPath="RobustSigma" Width="100">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Robust Sigma" Style="{StaticResource ColHeaderLabel}"/>
                                    <TextBox Style="{StaticResource ColFilterBox}" Tag="RobustSigma"
                                             TextChanged="ColumnFilter_Changed"
                                             PreviewMouseLeftButtonDown="HeaderFilter_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SummaryCellText}" Binding="{Binding Cpk, StringFormat=F3, TargetNullValue=-, Mode=OneTime}" SortMemberPath="Cpk" Width="55">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Cpk" Style="{StaticResource ColHeaderLabel}"/>
                                    <TextBox Style="{StaticResource ColFilterBox}" Tag="Cpk"
                                             TextChanged="ColumnFilter_Changed"
                                             PreviewMouseLeftButtonDown="HeaderFilter_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn CellStyle="{StaticResource YieldHeatCell}" ElementStyle="{StaticResource SummaryCellText}" Binding="{Binding InSpecPercent, StringFormat=F1, Mode=OneTime}" SortMemberPath="InSpecPercent" Width="70">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="InSpec%" Style="{StaticResource ColHeaderLabel}" ToolTip="良率色标：0% 红色 → 50% 黄色 → 100% 绿色；无有效数值时不着色"/>
                                    <TextBox Style="{StaticResource ColFilterBox}" Tag="InSpec"
                                             TextChanged="ColumnFilter_Changed"
                                             PreviewMouseLeftButtonDown="HeaderFilter_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </controls:FastDataGrid>
            </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeWE"/>
            <Grid Grid.Column="2" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="HistogramRow" Height="1.1*" MinHeight="190"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition x:Name="ScatterRow" Height="*" MinHeight="158"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="TxtItemTitle" Text="选择测试项查看分布" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtUnit" Text="从左侧列表选择一行" Margin="0,3,0,4" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                        <ListBox x:Name="CmbBinMode" SelectedIndex="0" BorderThickness="0" Background="Transparent" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="直方图模式" SelectionChanged="CmbBinMode_SelectionChanged"
                                 ItemContainerStyle="{StaticResource SegmentOption}">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBoxItem Content="固定等宽"/><ListBoxItem Content="规格区间"/><ListBoxItem Content="中位数中心"/>
                        </ListBox>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Background="White" CornerRadius="9" Padding="4">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,2">
                            <controls:ActionIcon Kind="Chart" Width="14" Height="14" Stroke="#64748B" Margin="0,0,6,0"/>
                            <TextBlock Text="直方图" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                        <controls:HistogramControl x:Name="Histogram"/>
                    </DockPanel>
                </Border>
                <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeNS"/>
                <Border Grid.Row="3" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Background="White" CornerRadius="9" Padding="4">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,2">
                            <controls:ActionIcon Kind="Scatter" Width="14" Height="14" Stroke="#64748B" Margin="0,0,6,0"/>
                            <TextBlock Text="散点图" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                        <controls:ScatterPlotControl x:Name="ScatterPlot"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
